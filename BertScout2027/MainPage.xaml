                        Clicked="ScoreStar0Clicked"
                        Margin="0,0,0,0"
                        BackgroundColor="LightGray"
                        WidthRequest="50"
                        HorizontalOptions="Center" />

                    <Button
                        x:Name="ScoreStar1"
                        Text="1"
                        Clicked="ScoreStar1Clicked"
                        Margin="5,0,0,0"
                        BackgroundColor="LightGray"
                        WidthRequest="50"
                        HorizontalOptions="Center" />

                    <Button
                        x:Name="ScoreStar2"
                        Text="2"
                        Clicked="ScoreStar2Clicked"
                        Margin="5,0,0,0"
                        BackgroundColor="LightGray"
                        WidthRequest="50"
                        HorizontalOptions="Center" />

                    <Button
                        x:Name="ScoreStar3"
                        Text="3"
                        Clicked="ScoreStar3Clicked"
                        Margin="5,0,0,0"
                        BackgroundColor="LightGray"
                        WidthRequest="50"
                        HorizontalOptions="Center" />

                    <Button
                        x:Name="ScoreStar4"
                        Text="4"
                        Clicked="ScoreStar4Clicked"
                        Margin="5,0,0,0"
                        BackgroundColor="LightGray"
                        WidthRequest="50"
                        HorizontalOptions="Center" />

                    <Button
                        x:Name="ScoreStar5"
                        Text="5"
                        Clicked="ScoreStar5Clicked"
                        Margin="5,0,0,0"
                        BackgroundColor="LightGray"
                        WidthRequest="50"
                        HorizontalOptions="Center" />

                </HorizontalStackLayout>

                <HorizontalStackLayout
                    HorizontalOptions="Center"
                    Margin="0,0,0,0"
                    >

                    <Label
                        Text="Defense (# of stars):"
                        HorizontalTextAlignment="Center"
                        WidthRequest="245"
                        Style="{StaticResource SubHeadline}"
                        FontSize="{OnPlatform WinUI=Small, Android=Medium}"
                        />

                    <Button
                        x:Name="DefenseScoreStar0"
                        Text="0"
                        Clicked="DefenseScoreStar0Clicked"
                        Margin="0,0,0,0"
                        BackgroundColor="LightGray"
                        WidthRequest="50"
                        HorizontalOptions="Center" />

                    <Button
                        x:Name="DefenseScoreStar1"
                        Text="1"
                        Clicked="DefenseScoreStar1Clicked"
                        Margin="5,0,0,0"
                        BackgroundColor="LightGray"
                        WidthRequest="50"
                        HorizontalOptions="Center" />

                    <Button
                        x:Name="DefenseScoreStar2"
                        Text="2"
                        Clicked="DefenseScoreStar2Clicked"
                        Margin="5,0,0,0"
                        BackgroundColor="LightGray"
                        WidthRequest="50"
                        HorizontalOptions="Center" />

                    <Button
                        x:Name="DefenseScoreStar3"
                        Text="3"
                        Clicked="DefenseScoreStar3Clicked"
                        Margin="5,0,0,0"
                        BackgroundColor="LightGray"
                        WidthRequest="50"
                        HorizontalOptions="Center" />

                    <Button
                        x:Name="DefenseScoreStar4"
                        Text="4"
                        Clicked="DefenseScoreStar4Clicked"
                        Margin="5,0,0,0"
                        BackgroundColor="LightGray"
                        WidthRequest="50"
                        HorizontalOptions="Center" />

                    <Button
                        x:Name="DefenseScoreStar5"
                        Text="5"
                        Clicked="DefenseScoreStar5Clicked"
                        Margin="5,0,0,0"
                        BackgroundColor="LightGray"
                        WidthRequest="50"
                        HorizontalOptions="Center" />

                </HorizontalStackLayout>

                <Grid>
                    <HorizontalStackLayout
                        HorizontalOptions="Center">
                        <Label
                            Text="Select some comments:"
                        />
                        <Picker
                        x:Name="CommentPicker"
                        SelectedIndexChanged="CommentPicker_SelectedIndexChanged"
                        HeightRequest="32"
                        WidthRequest="200"
                        Margin="10,0,0,0"
                        FontSize="{OnPlatform WinUI=Small, Android=Medium}"
                        />
                    </HorizontalStackLayout>
                </Grid>

                <Grid
                    HorizontalOptions="Fill"
                    Margin="0,0,0,300"
                    >

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Editor
                        x:Name="Comments"
                        Grid.Row="0"
                        Placeholder="Put in comments"
                        PlaceholderColor="LightGray"
                        MaxLength="250"
                        HeightRequest="150"
                        Margin="10,5,10,0"
                        Text=""
                        IsEnabled="true"
                        FontSize="{OnPlatform WinUI=Small, Android=Medium}"
                        TextChanged="Comments_TextChanged"
                        />

                    <Button
                        x:Name="SaveButton"
                        Text="Save"
                        Clicked="SaveButtonClicked"
                        Margin="0,10,0,0"
                        BackgroundColor="Green"
                        WidthRequest="80"
                        VerticalOptions="Start"
                        Grid.Row="1"
                        />

                </Grid>

            </VerticalStackLayout>

            <VerticalStackLayout
                x:Name="ErrorLayout"
                IsVisible="False"
                Grid.Row="2"
                Padding="30,0"
                >

                <Label
                    x:Name="ErrorMsg"
                    Text="ERROR"
                    TextColor="Red"
                    FontSize="{OnPlatform WinUI=Small, Android=Medium}"
                    />

            </VerticalStackLayout>

        </Grid>

    </ScrollView>

</ContentPage>
