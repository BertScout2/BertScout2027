<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:BertScout2027"
    x:Class="BertScout2027.MainPage"
    x:DataType="local:GlobalViewModel"
    >

    <ScrollView>

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <VerticalStackLayout
                x:Name="MainLayout"
                Grid.Row="0"
                IsVisible="True"
                Padding="30,0"
                Spacing="25">

                <Image
                    Source="bert_logo.png"
                    HeightRequest="148"
                    Aspect="AspectFit"
                    />

                <HorizontalStackLayout
                    HorizontalOptions="Center">

                    <Label
                        Text="Scout:"
                        Margin="10,0,0,0"
                        FontSize="{OnPlatform WinUI=Small, Android=Medium}"
                        />

                    <Label
                        x:Name="ScoutNameDisplay"
                        Text="{Binding ScouterName}"
                        Margin="10,0,0,0"
                        FontSize="{OnPlatform WinUI=Small, Android=Medium}"
                        />

                </HorizontalStackLayout>

                <HorizontalStackLayout 
                    x:Name="TeamMatchLayout"
                    HorizontalOptions="Center"
                    Padding="30,0"
                    Spacing="0">

                    <Label
                        Text="Match#:"
                        Margin="10,12,10,0"
                        Style="{StaticResource Headline}"
                        FontSize="{OnPlatform WinUI=Small, Android=Medium}"
                        />

                    <Entry
                        x:Name="EntryMatchNumber"
                        WidthRequest="60"
                        Keyboard="Numeric"
                        MaxLength="3"
                        IsEnabled="True"
                        Text="{Binding TargetMatchNumber}"
                        FontSize="{OnPlatform WinUI=Small, Android=Medium}"
                        />

                    <Label
                        Text="Team#:"
                        Margin="10,12,10,0"
                        Style="{StaticResource Headline}"
                        FontSize="{OnPlatform WinUI=Small, Android=Medium}"
                        />

                    <Entry
                        x:Name="EntryTeamNumber"
                        WidthRequest="70"
                        Keyboard="Numeric"
                        MaxLength="5"
                        IsEnabled="True"
                        Text=""
                        FontSize="{OnPlatform WinUI=Small, Android=Medium}"
                        />

                    <Button
                        x:Name="StartButton"
                        Text="Start"
                        Clicked="StartButtonClicked"
                        Margin="20,10,0,0"
                        BackgroundColor="Green"
                        WidthRequest="80"
                        IsVisible="True"
                        IsEnabled="True"
                        />

                </HorizontalStackLayout>
                
                <HorizontalStackLayout
                    HorizontalOptions="Center">

                    <Label
                        x:Name="ErrorLabelTop"
                        TextColor="Red"
                        Text=""
                        IsVisible="False"
                        FontSize="{OnPlatform WinUI=Small, Android=Medium}"
                        />

                </HorizontalStackLayout>

            </VerticalStackLayout>

            <VerticalStackLayout
                x:Name="ScoutingLayout"
                IsVisible="False"
                Grid.Row="1"
                >

                <Grid
                    BackgroundColor="Green"
                    Margin="0,10,0,0"
                    >

                    <Label
                        Text="Autonomous"
                        HorizontalTextAlignment="Center"
